includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 10

    # Infer Eloquent column types from the SQL schema used by MariaDB.
    squashedMigrationsPath:
        - %currentWorkingDirectory%/../sql

    paths:
        - app

    tmpDir: storage/phpstan

    reportUnmatchedIgnoredErrors: true
